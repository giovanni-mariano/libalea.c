# Valgrind suppression file for libalea
#
# Suppresses known false positives from system libraries and embedded Lua.
# Add new suppressions here rather than weakening Valgrind flags.

# Lua internal allocator - Lua manages its own GC and may hold reachable
# memory at exit that Valgrind reports as "possibly lost".
{
   lua_newstate_possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:luaM_malloc_
   ...
}
{
   lua_newstate_realloc_possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:luaM_realloc_
   ...
}

# OpenMP (libgomp) thread pool - TLS allocated by pthread_create is kept
# alive for thread reuse and reported as "possibly lost" at exit.
{
   gomp_thread_pool_possible
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@GLIBC_2.34
   ...
}
{
   gomp_thread_pool_possible_alt
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:allocate_stack
   fun:pthread_create*
   ...
   obj:*/libgomp.so*
   ...
}

# dlopen/dlclose can leave reachable blocks
{
   dlopen_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:dlopen@@*
   ...
}
{
   dlclose_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:dlclose
   ...
}
