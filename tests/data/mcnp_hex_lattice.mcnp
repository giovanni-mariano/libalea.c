Hex lattice test
c --- universe 1: fuel pin ---
1 1 -1.0  -10      u=1 imp:n=1
2 2 -1.0   10      u=1 imp:n=1
c --- universe 3: another pin ---
3 3 -1.0  -10      u=3 imp:n=1
4 4 -1.0   10      u=3 imp:n=1
c --- hex lattice cell (flat-top hex) ---
c 6 oblique planes forming a regular hexagonal prism, flat-to-flat = 2.0
c normals at 0, 60, 120 deg, each face at distance p/2 = 1.0 from center
c pitch = 2.0, hex side = 2/sqrt(3) ~ 1.1547
100 0  1 -2 3 -4 5 -6 7 -8 lat=2 fill=-1:1 -1:1 0:0
     1 3 1  3 1 3  1 3 1  imp:n=1

c Surfaces
c hex pair 1: normal (1, 0, 0) at d = +-1
1  px -1
2  px  1
c hex pair 2: normal (0.5, sqrt(3)/2, 0) at d = +-1
3  p  0.5  0.86602540  0.0  -1.0
4  p  0.5  0.86602540  0.0   1.0
c hex pair 3: normal (-0.5, sqrt(3)/2, 0) at d = +-1
5  p -0.5  0.86602540  0.0  -1.0
6  p -0.5  0.86602540  0.0   1.0
c z planes
7  pz -1
8  pz  1
c fuel pin cylinder
10 cz 0.3

m1 92235.80c 1.0
