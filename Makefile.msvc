		$(BUILD)\lua_bind\lua_util.obj

LUA_MAIN_OBJ = $(BUILD)\lua_bind\lua_main.obj

# ============================================================================
# Library outputs (mirror the .a names from the GNU Makefile)
# ============================================================================
LIB_CORE    = $(BIN)\libalea.lib
LIB_MCNP    = $(BIN)\libalea_mcnp.lib
LIB_OPENMC  = $(BIN)\libalea_openmc.lib
LIB_SERPENT = $(BIN)\libalea_serpent.lib
LIB_NUCDATA = $(BIN)\libalea_nucdata.lib
LIB_FULL    = $(BIN)\libalea_full.lib
ALEA_CLI    = $(BIN)\alea.exe

# Module libs are pulled in with /WHOLEARCHIVE (the MSVC analogue of GNU
# --whole-archive used by the test/CLI links in the GNU Makefile), so any
# self-contained module objects the tests and CLI rely on are not dropped.
MODULE_LINK = /link \
	/WHOLEARCHIVE:$(LIB_MCNP) \
	/WHOLEARCHIVE:$(LIB_OPENMC) \
	/WHOLEARCHIVE:$(LIB_SERPENT) \
	/WHOLEARCHIVE:$(LIB_NUCDATA)

ALL_OBJS = $(CORE_LIB_OBJS) $(MCNP_OBJS) $(OPENMC_OBJS) $(SERPENT_OBJS) $(NUCDATA_OBJS)

# ============================================================================
# Header dependency tracking
# ============================================================================
# The GNU Makefile gets precise per-object header deps from `-MMD -MP`. nmake
# has no equivalent: the only automatic option is parsing `cl /showIncludes`,
# whose "Note: including file:" prefix is localized (breaks on non-English MSVC)
# and needs generated dep fragments + a filter script.
#
# Keep this list as documentation for the headers under include/ and src/.
# It is not wired into the object rules because jom 1.1.5 treats explicit
# dependency-only object rules as complete rules and then skips `.c -> .obj`
# inference. Regenerate: `find include src -name '*.h' | grep -v lua_bind`.
HEADERS = \
	include\alea.h \
	include\alea_geo_validator.h \
	include\alea_mcnp.h \
	include\alea_mesh.h \
	include\alea_nucdata.h \
	include\alea_nucdata_types.h \
	include\alea_openmc.h \
	include\alea_raycast.h \
	include\alea_render.h \
	include\alea_serpent.h \
	include\alea_slice.h \
	include\alea_types.h \
	src\core\alea_cell.h \
	src\core\alea_cell_complement.h \
	src\core\alea_eval.h \
	src\core\alea_export.h \
	src\core\alea_macrobody.h \
	src\core\alea_materials.h \
	src\core\alea_ops.h \
	src\core\alea_simplify.h \
	src\core\alea_spatial_hier.h \
	src\core\alea_surface.h \
	src\core\alea_system.h \
	src\core\alea_transform.h \
	src\core\alea_universe.h \
	src\core\alea_void.h \
	src\geo_validator\geo_validator.h \
	src\mcnp\conversion\cell_conv.h \
	src\mcnp\conversion\mcnp_conversion.h \
	src\mcnp\conversion\surface_conv.h \
	src\mcnp\exporter\mcnp_export.h \
	src\mcnp\exporter\mcnp_str.h \
	src\mcnp\mcnp_model.h \
	src\mcnp\parser\geom_lexer.h \
	src\mcnp\parser\geom_parser.h \
	src\mcnp\parser\mcnp_lexer.h \
	src\mcnp\parser\mcnp_parser.h \
	src\nucdata\constants.h \
	src\nucdata\nuclear_internal.h \
	src\openmc\openmc_conversion.h \
	src\openmc\openmc_export.h \
	src\openmc\openmc_model.h \
	src\openmc\openmc_parse.h \
	src\openmc\openmc_region.h \
	src\openmc\openmc_xml.h \
	src\primitives\bbox.h \
	src\primitives\primitive_create.h \
	src\primitives\primitive_desc.h \
	src\primitives\primitive_eval.h \
	src\raycast\bvh.h \
	src\raycast\ray_bbox.h \
	src\raycast\ray_epsilon.h \
	src\raycast\ray_intersect.h \
	src\raycast\raycast.h \
	src\render\render3d.h \
	src\serpent\serpent_export.h \
	src\slice\curve_intersect.h \
	src\slice\slice_epsilon.h \
	src\util\alea_atomic.h \
	src\util\alea_bitset.h \
	src\util\alea_hashmap.h \
	src\util\alea_log.h \
	src\util\alea_svg.h \
	src\util\alea_vec.h \
	src\util\arena.h \
	src\util\compat.h \
	src\util\math.h \
	src\util\poly_solve.h \
	src\util\str_builder.h

# Coarse object->header dependencies are intentionally not expressed here.
# nmake can combine explicit dependency-only object rules with inference rules,
# but jom 1.1.5 does not: it treats `target.obj: headers...` as the complete
# rule and skips the `.c -> .obj` inference rule, then the archive step fails
# with missing objects. Keep the clean-build jom path working; use `clean` after
# header edits on this build driver.

# ============================================================================
# Phony-ish targets
# ============================================================================
all: dirs $(LIB_CORE) $(LIB_MCNP) $(LIB_OPENMC) $(LIB_SERPENT) $(LIB_NUCDATA)

full: all $(LIB_FULL)

libs: all

cli: all $(ALEA_CLI)

# ----------------------------------------------------------------------------
# Library link (static) via LIB.EXE
# ----------------------------------------------------------------------------
$(LIB_CORE): $(CORE_LIB_OBJS)
	$(AR) /nologo /OUT:$@ $(CORE_LIB_OBJS)

$(LIB_MCNP): $(MCNP_OBJS)
	$(AR) /nologo /OUT:$@ $(MCNP_OBJS)

$(LIB_OPENMC): $(OPENMC_OBJS)
	$(AR) /nologo /OUT:$@ $(OPENMC_OBJS)

$(LIB_SERPENT): $(SERPENT_OBJS)
	$(AR) /nologo /OUT:$@ $(SERPENT_OBJS)

$(LIB_NUCDATA): $(NUCDATA_OBJS)
	$(AR) /nologo /OUT:$@ $(NUCDATA_OBJS)

$(LIB_FULL): $(ALL_OBJS)
	$(AR) /nologo /OUT:$@ $(ALL_OBJS)

# ============================================================================
# Inference rules (one per source directory).
# Standard single-colon inference rules: compile each out-of-date source in its
# own $(CC) call. This is portable across both nmake and jom (Qt's nmake clone,
# the conda-only / no-Visual-Studio build driver). NOTE: do NOT use the nmake
# batch-mode form `.obj::` here -- jom does not implement batch inference rules,
# so it silently skips compilation and then fails at lib time with missing .obj.
# ============================================================================
{$(SRC)\core\}.c{$(BUILD)\core\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\core\ $<

{$(SRC)\util\}.c{$(BUILD)\util\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\util\ $<

{$(SRC)\primitives\}.c{$(BUILD)\primitives\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\primitives\ $<

{$(SRC)\raycast\}.c{$(BUILD)\raycast\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\raycast\ $<

{$(SRC)\slice\}.c{$(BUILD)\slice\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\slice\ $<

{$(SRC)\render\}.c{$(BUILD)\render\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\render\ $<

{$(SRC)\mesh\}.c{$(BUILD)\mesh\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\mesh\ $<

{$(SRC)\geo_validator\}.c{$(BUILD)\geo_validator\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\geo_validator\ $<

{$(SRC)\mcnp\}.c{$(BUILD)\mcnp\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\mcnp\ $<

{$(SRC)\mcnp\parser\}.c{$(BUILD)\mcnp\parser\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\mcnp\parser\ $<

{$(SRC)\mcnp\conversion\}.c{$(BUILD)\mcnp\conversion\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\mcnp\conversion\ $<

{$(SRC)\mcnp\exporter\}.c{$(BUILD)\mcnp\exporter\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\mcnp\exporter\ $<

{$(SRC)\openmc\}.c{$(BUILD)\openmc\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\openmc\ $<

{$(SRC)\serpent\}.c{$(BUILD)\serpent\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\serpent\ $<

{$(SRC)\nucdata\}.c{$(BUILD)\nucdata\}.obj:
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\nucdata\ $<

{$(LUA)\}.c{$(BUILD)\lua\}.obj:
	$(CC) $(LUA_CFLAGS) /I $(LUA) /c /Fo$(BUILD)\lua\ $<

{$(SRC)\lua_bind\}.c{$(BUILD)\lua_bind\}.obj:
	$(CC) $(CFLAGS) $(LUA_INCLUDES) /c /Fo$(BUILD)\lua_bind\ $<

$(ALEA_CLI): dirs $(LUA_OBJS) $(LUA_BIND_OBJS) $(LUA_MAIN_OBJ) $(LIB_CORE) $(LIB_MCNP) $(LIB_OPENMC) $(LIB_SERPENT) $(LIB_NUCDATA)
	$(CC) $(CFLAGS) $(LUA_INCLUDES) $(LUA_MAIN_OBJ) $(LUA_BIND_OBJS) $(LUA_OBJS) $(LIB_CORE) /Fe$@ $(MODULE_LINK)

# ============================================================================
# Tests
# ============================================================================
TEST_LINK = $(MODULE_LINK)

# Build + run every tests\unit\*.c and tests\integration\*.c.
# nmake has no $(wildcard); a cmd FOR loop discovers the sources at run time.
# (`%%f` -> `%f` is passed to cmd, which is what a command-line FOR expects.)
test: test-unit test-integration test-lua

test-unit: libs
	@if not exist $(BIN)\tests\unit mkdir $(BIN)\tests\unit
	@for %%f in (tests\unit\*.c) do @( \
		echo TEST %%~nf && \
		$(CC) $(TEST_CFLAGS) $(TEST_INCLUDES) /Fo$(BIN)\tests\unit\ \
			tests\unit\%%~nf.c $(LIB_CORE) /Fe$(BIN)\tests\unit\%%~nf.exe $(TEST_LINK) && \
		$(BIN)\tests\unit\%%~nf.exe || exit /b 1 )
	@echo All unit tests passed.

test-integration: libs
	@if not exist $(BIN)\tests\integration mkdir $(BIN)\tests\integration
	@for %%f in (tests\integration\*.c) do @( \
		echo TEST %%~nf && \
		$(CC) $(TEST_CFLAGS) $(TEST_INCLUDES) /Fo$(BIN)\tests\integration\ \
			tests\integration\%%~nf.c $(LIB_CORE) /Fe$(BIN)\tests\integration\%%~nf.exe $(TEST_LINK) && \
		$(BIN)\tests\integration\%%~nf.exe || exit /b 1 )
	@echo All integration tests passed.

test-lua: cli
	@for %%f in (tests\lua\test_*.lua) do @( \
		echo Running %%f && \
		$(ALEA_CLI) %%f || exit /b 1 )
	@echo All Lua tests passed.

# ============================================================================
# Directory creation
# ============================================================================
dirs:
	@if not exist $(BIN) mkdir $(BIN)
	@if not exist $(BUILD) mkdir $(BUILD)
	@if not exist $(BUILD)\core mkdir $(BUILD)\core
	@if not exist $(BUILD)\util mkdir $(BUILD)\util
	@if not exist $(BUILD)\primitives mkdir $(BUILD)\primitives
	@if not exist $(BUILD)\raycast mkdir $(BUILD)\raycast
	@if not exist $(BUILD)\slice mkdir $(BUILD)\slice
	@if not exist $(BUILD)\render mkdir $(BUILD)\render
	@if not exist $(BUILD)\mesh mkdir $(BUILD)\mesh
	@if not exist $(BUILD)\geo_validator mkdir $(BUILD)\geo_validator
	@if not exist $(BUILD)\mcnp mkdir $(BUILD)\mcnp
	@if not exist $(BUILD)\mcnp\parser mkdir $(BUILD)\mcnp\parser
	@if not exist $(BUILD)\mcnp\conversion mkdir $(BUILD)\mcnp\conversion
	@if not exist $(BUILD)\mcnp\exporter mkdir $(BUILD)\mcnp\exporter
	@if not exist $(BUILD)\openmc mkdir $(BUILD)\openmc
	@if not exist $(BUILD)\serpent mkdir $(BUILD)\serpent
	@if not exist $(BUILD)\nucdata mkdir $(BUILD)\nucdata
	@if not exist $(BUILD)\lua mkdir $(BUILD)\lua
	@if not exist $(BUILD)\lua_bind mkdir $(BUILD)\lua_bind

# ============================================================================
# Clean
# ============================================================================
clean:
	@if exist $(BUILD) rmdir /s /q $(BUILD)
	@if exist $(LIB_CORE) del /q $(LIB_CORE)
	@if exist $(LIB_MCNP) del /q $(LIB_MCNP)
	@if exist $(LIB_OPENMC) del /q $(LIB_OPENMC)
	@if exist $(LIB_SERPENT) del /q $(LIB_SERPENT)
	@if exist $(LIB_NUCDATA) del /q $(LIB_NUCDATA)
	@if exist $(LIB_FULL) del /q $(LIB_FULL)
	@if exist $(ALEA_CLI) del /q $(ALEA_CLI)
	@if exist $(BIN)\tests rmdir /s /q $(BIN)\tests
