		$(BUILD)\lua\liolib.obj \
		$(BUILD)\lua\llex.obj \
		$(BUILD)\lua\lmathlib.obj \
		$(BUILD)\lua\lmem.obj \
		$(BUILD)\lua\loadlib.obj \
		$(BUILD)\lua\lobject.obj \
