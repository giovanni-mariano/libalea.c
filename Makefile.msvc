		$(BUILD)\lua_bind\lua_ops.obj \
		$(BUILD)\lua_bind\lua_query.obj \
		$(BUILD)\lua_bind\lua_raycast.obj \
		$(BUILD)\lua_bind\lua_render.obj \
		$(BUILD)\lua_bind\lua_slice.obj \
		$(BUILD)\lua_bind\lua_surfaces.obj \
