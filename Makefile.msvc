	$(BUILD)\nucdata\xs_decode.obj \
	$(BUILD)\nucdata\lookup.obj \
	$(BUILD)\nucdata\material.obj \
	$(BUILD)\nucdata\reaction.obj \
	$(BUILD)\nucdata\angular.obj \
