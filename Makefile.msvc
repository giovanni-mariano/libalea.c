	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\primitives\ $(SRC)\primitives\primitive_desc.c

$(BUILD)\primitives\bbox.obj: $(SRC)\primitives\bbox.c dirs
