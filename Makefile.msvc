CORE_LIB_OBJS = $(CORE_OBJS) $(UTIL_OBJS) $(TINYPAR_OBJS) $(PRIMITIVES_OBJS) $(RNG_OBJS) $(RAYCAST_OBJS) \
	$(SLICE_OBJS) $(RENDER_OBJS) $(MESH_OBJS) $(GEO_VALIDATOR_OBJS)

