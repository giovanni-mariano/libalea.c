	$(BUILD)\core\alea_export.obj \
	$(BUILD)\core\alea_tolerance.obj \
	$(BUILD)\core\alea_primitive_dedup.obj \
	$(BUILD)\core\alea_materials.obj \
	$(BUILD)\core\alea_elements_data.obj \
	$(BUILD)\core\alea_error.obj \
	$(BUILD)\core\alea_public_api.obj \
	$(BUILD)\core\alea_eval.obj \
	$(BUILD)\core\alea_ops.obj \
	$(BUILD)\core\alea_simplify.obj \
	$(BUILD)\core\alea_universe.obj \
	$(BUILD)\core\alea_cell_complement.obj \
	$(BUILD)\core\alea_void.obj \
	$(BUILD)\core\alea_macrobody.obj \
	$(BUILD)\core\alea_spatial_hier.obj

UTIL_OBJS = \
	$(BUILD)\util\arena.obj \
	$(BUILD)\util\str_builder.obj \
	$(BUILD)\util\alea_log.obj \
	$(BUILD)\util\poly_solve.obj \
	$(BUILD)\util\compat.obj \
	$(BUILD)\util\alea_svg.obj

PRIMITIVES_OBJS = \
	$(BUILD)\primitives\primitive_eval.obj \
	$(BUILD)\primitives\primitive_create.obj \
	$(BUILD)\primitives\primitive_desc.obj \
	$(BUILD)\primitives\bbox.obj

RAYCAST_OBJS = \
	$(BUILD)\raycast\raycast.obj \
	$(BUILD)\raycast\ray_intersect.obj \
	$(BUILD)\raycast\bvh.obj \
	$(BUILD)\raycast\raycast_api.obj

SLICE_OBJS = \
