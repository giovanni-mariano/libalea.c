	$(BUILD)\nucdata\material_bridge.obj

LUA_OBJS = \
		$(BUILD)\lua\lapi.obj \
		$(BUILD)\lua\lauxlib.obj \
		$(BUILD)\lua\lbaselib.obj \
		$(BUILD)\lua\lcode.obj \
		$(BUILD)\lua\lcorolib.obj \
		$(BUILD)\lua\lctype.obj \
		$(BUILD)\lua\ldblib.obj \
		$(BUILD)\lua\ldebug.obj \
		$(BUILD)\lua\ldo.obj \
		$(BUILD)\lua\ldump.obj \
		$(BUILD)\lua\lfunc.obj \
		$(BUILD)\lua\lgc.obj \
