# SPDX-FileCopyrightText: 2026 Giovanni MARIANO
#
# SPDX-License-Identifier: MPL-2.0
#
# ============================================================================
# Makefile.msvc - MSVC (cl.exe) build driver for the Alea C library
# ============================================================================
#
# Usage (from a "x64 Native Tools Command Prompt for VS" or after vcvars64.bat):
#
#     nmake /f Makefile.msvc                 # build all static libraries
#     nmake /f Makefile.msvc test            # build + run unit & integration tests
#     nmake /f Makefile.msvc RELEASE=1       # optimized build (default is /Od /Zi)
#     nmake /f Makefile.msvc USE_OPENMP=1    # enable OpenMP (/openmp:llvm, VS2019 16.9+)
#     nmake /f Makefile.msvc CONDA_CLANG=1   # use conda clang-cl/llvm-lib
#     nmake /f Makefile.msvc clean
#
# This is the MSVC counterpart to the GNU `Makefile`. It deliberately mirrors
# the same source lists and the same library layout (libalea + format modules).
# The CLI target embeds vendored Lua and skips linenoise on Windows.
#
# ----------------------------------------------------------------------------
# Migration status (docs/MSVC_MIGRATION_PLAN.md)
# ----------------------------------------------------------------------------
# Phases 1-2-5 are in the tree: atomics shim (src/util/alea_atomic.h),
# ALEA_THREAD_LOCAL, and the POSIX compat sweep (monotonic clock + portable
# mutex via SRWLOCK in src/util/compat.{h,c}; guarded <unistd.h> in alea_log.c;
# mcnp_parser.c already had a _WIN32 mmap branch). No known POSIX/GCC-isms
# remain in the library sources.
#
# NOTE: not yet validated on a real cl.exe toolchain — expect to triage MSVC
# warnings/quirks on first CI run.
# ============================================================================

# ----------------------------------------------------------------------------
# Environment guard
# ----------------------------------------------------------------------------
# vcvars sets VCINSTALLDIR; nmake exposes env vars as macros. Without a VS x64
# dev environment, cl/lib aren't on PATH and the build fails deep inside with a
# cryptic "vcruntime.h not found" — turn that into one clear line. The wrapper
# (build-msvc.ps1) sets this up automatically; bare nmake needs vcvarsall x64.
# CONDA_CLANG=1 is the no-admin conda clang_win-64 path; it relies on conda's
# activation scripts and SDK/header setup instead of a Visual Studio prompt.
!IFNDEF CONDA_CLANG
!IFNDEF VCINSTALLDIR
!ERROR No VS x64 dev environment (VCINSTALLDIR unset). Use build-msvc.ps1, or run `vcvarsall.bat x64` first.
!ENDIF
!ENDIF

# ----------------------------------------------------------------------------
# Toolchain
# ----------------------------------------------------------------------------
!IFDEF CONDA_CLANG
CC   = clang-cl
AR   = llvm-lib
!ELSE
CC   = cl
AR   = lib
!ENDIF

# ----------------------------------------------------------------------------
# Directories
# ----------------------------------------------------------------------------
SRC   = src
BUILD = build_msvc
BIN   = bin
LUA   = vendor\lua\src

INCLUDES = /I include /I $(SRC)
LUA_INCLUDES = $(INCLUDES) /I $(LUA)

# ----------------------------------------------------------------------------
# Compiler flags
# ----------------------------------------------------------------------------
# /std:c11      - C11 mode (needed for _Generic-free atomics shim, designated inits)
# /MD           - dynamic CRT (matches the portable, redistributable intent)
# /W3           - default-ish warning level; raise to /W4 once warnings are triaged
# /utf-8        - source/exec charset (files contain UTF-8 box-drawing in comments)
# _CRT_SECURE_NO_WARNINGS / _CRT_NONSTDC_NO_WARNINGS - silence strdup/strcpy noise

# OpenMP flag, shared by the library AND the tests. It MUST go on both: the test
# exes link libalea.lib, whose objects (render3d.c, slice_api.c) carry omp
# pragmas and reference libomp symbols (__kmpc_*). Building tests without the
# flag while the library was built with it would leave those unresolved at link.
# Use /openmp:llvm, not plain /openmp (OpenMP 2.0): slice_api.c uses
# `omp for collapse(2)` (OpenMP 3.0+), the one construct the 2.0 runtime rejects.
# Everything else here is even 2.0-compatible (all signed int loop counters,
# plain `atomic` update, named `critical`, schedule(dynamic,N)). /openmp:llvm is
# x64-only (matches this build); exes load libomp140.x86_64.dll at runtime, so
# the wrapper puts that redist on PATH for test runs.
!IFDEF USE_OPENMP
OMP_FLAGS = /openmp:llvm
!ELSE
OMP_FLAGS =
!ENDIF

CFLAGS = /nologo /std:c11 /W3 /utf-8 /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS $(OMP_FLAGS)

!IFDEF RELEASE
CFLAGS = $(CFLAGS) /O2 /DNDEBUG
!ELSE
CFLAGS = $(CFLAGS) /Od /Zi
!ENDIF

# Tests keep asserts active (strip /DNDEBUG) and are always debuggable.
TEST_CFLAGS   = /nologo /std:c11 /W3 /utf-8 /Od /Zi /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS $(OMP_FLAGS)
TEST_INCLUDES = $(INCLUDES) /I tests
LUA_CFLAGS    = /nologo /std:c11 /W3 /utf-8 /O2 /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS

# ============================================================================
# Source -> object lists (mirror of the GNU Makefile)
# ============================================================================

# --- core engine -----------------------------------------------------------
CORE_OBJS = \
