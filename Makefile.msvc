MESH_OBJS = \
	$(BUILD)\mesh\mesh_export.obj

GEO_VALIDATOR_OBJS = \
	$(BUILD)\geo_validator\geo_validator.obj

CORE_LIB_OBJS = $(CORE_OBJS) $(UTIL_OBJS) $(PRIMITIVES_OBJS) $(RAYCAST_OBJS) \
	$(SLICE_OBJS) $(RENDER_OBJS) $(MESH_OBJS) $(GEO_VALIDATOR_OBJS)

# --- MCNP module -----------------------------------------------------------
MCNP_OBJS = \
	$(BUILD)\mcnp\parser\mcnp_parser.obj \
	$(BUILD)\mcnp\parser\mcnp_lexer.obj \
	$(BUILD)\mcnp\parser\geom_parser.obj \
	$(BUILD)\mcnp\parser\geom_lexer.obj \
	$(BUILD)\mcnp\conversion\mcnp_conversion.obj \
	$(BUILD)\mcnp\conversion\surface_conv.obj \
	$(BUILD)\mcnp\conversion\cell_conv.obj \
	$(BUILD)\mcnp\exporter\mcnp_str.obj \
	$(BUILD)\mcnp\exporter\mcnp_export.obj \
	$(BUILD)\mcnp\mcnp_model.obj

# --- OpenMC module ---------------------------------------------------------
OPENMC_OBJS = \
	$(BUILD)\openmc\openmc_xml.obj \
	$(BUILD)\openmc\openmc_export.obj \
	$(BUILD)\openmc\openmc_parse.obj \
	$(BUILD)\openmc\openmc_region.obj \
	$(BUILD)\openmc\openmc_conversion.obj \
	$(BUILD)\openmc\openmc_model.obj

# --- Serpent module --------------------------------------------------------
SERPENT_OBJS = \
