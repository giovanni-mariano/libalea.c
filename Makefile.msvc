$(BUILD)\core\alea_proof_simplify.obj: $(SRC)\core\alea_proof_simplify.c dirs
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\core\ $(SRC)\core\alea_proof_simplify.c

$(BUILD)\core\alea_void.obj: $(SRC)\core\alea_void.c dirs
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\core\ $(SRC)\core\alea_void.c

$(BUILD)\core\alea_macrobody.obj: $(SRC)\core\alea_macrobody.c dirs
	$(CC) $(CFLAGS) $(INCLUDES) /c /Fo$(BUILD)\core\ $(SRC)\core\alea_macrobody.c

